{
  "name": "warfare",
  "version": "0.1.0",
  "private": true,
  "description": "WarFare — ізометрична тактична покрокова гра (TypeScript, Babylon.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server --emptyOutDir",
    "server": "node dist-server/index.js",
    "build:hgs": "vite build -c vite.sim.config.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.32.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
